{
  "manifest_version": 3,
  "name": "Stash",
  "version": "0.2.0",
  "description": "In-memory file clipboard. Catch a download into RAM, drop it into any site's upload box. Nothing lands in Downloads.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Stash",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "util.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "key": ""
}